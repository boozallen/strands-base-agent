# Strands Base Agent — Environment Configuration
# ==============================================================================
# Copy to .env and fill in. This file is for SECRETS and ENVIRONMENT-SPECIFIC
# RUNTIME VALUES only — everything else (model, prompt, tools, sessions, MCP,
# A2A, etc.) lives in config.yaml.
#
# Configuration priority: config.yaml -> STRANDS__ env-var overrides -> defaults
#
# To override a config.yaml value at runtime (e.g. switching providers in a
# specific deployment without editing the file), set a STRANDS__-prefixed env
# var that mirrors the YAML key path with double-underscore nesting:
#
#     STRANDS__MODEL__PROVIDER=bedrock
#     STRANDS__MODEL__MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0
#     STRANDS__AGENT_NAME=my-agent
#
# Prefer editing config.yaml directly; reach for STRANDS__ overrides only when
# you genuinely need per-environment behavior.

# Server binding (Docker / runtime)
# ==============================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

## Public URL advertised in the agent card. Defaults to http://{agent_name}:{PORT}.
# STRANDS_AGENT_PUBLIC_URL=http://strands-agent:8000/

# AWS credentials (for Bedrock provider)
# ==============================================================================
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1

## Bedrock client timeouts
AWS_READ_TIMEOUT=900      # 15 minutes for long-running research tasks
AWS_CONNECT_TIMEOUT=60    # 1 minute for connection establishment

# Local model endpoints (env-specific)
# ==============================================================================
## Ollama / llama.cpp differ between local dev and Docker (host.docker.internal).
## Keep them as env vars rather than baking into config.yaml.
OLLAMA_URL=http://host.docker.internal:11434
# LLAMACPP_URL=http://host.docker.internal:8080

# Session encryption (required when session_type=file in config.yaml)
# ==============================================================================
## AES-256-GCM key for encrypting persisted session state. Must be a
## 64-character lowercase hex string, no separators (32 bytes). Server fails
## to start if session_type=file and this is unset.
## Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_ENCRYPTION_KEY=

# TLS Posture (required for production)
# ==============================================================================
## Declares how TLS is enforced. Server fails to start if unset.
## platform = TLS terminated by ingress/service mesh (uvicorn serves HTTP)
## native = uvicorn terminates TLS directly (requires keyfile and certfile)
STRANDS_TLS_MODE=platform
# STRANDS_TLS_KEYFILE=/path/to/key.pem
# STRANDS_TLS_CERTFILE=/path/to/cert.pem

# Outbound HTTP TLS (foundry-strands-agent package)
# ==============================================================================
## Controls certificate verification on outbound HTTP calls (MCP, A2A).
## Defaults to true. Only disable for local dev with self-signed certs.
# FOUNDRY_TLS_VERIFY=true

# CORS (HTTP API only — read directly by middleware, not config.yaml)
# ==============================================================================
# STRANDS_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# STRANDS_CORS_ALLOW_CREDENTIALS=false
# STRANDS_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
# STRANDS_CORS_ALLOW_HEADERS=Content-Type,Authorization

# Observability (OpenTelemetry)
# ==============================================================================
## Toggle export in config.yaml (observability_enabled). Endpoint, headers,
## and service metadata are env-specific and live here.
##
## Security note: the values below are local-dev defaults. For production or
## any shared environment, generate fresh credentials in your observability
## platform and update OTEL_EXPORTER_OTLP_HEADERS accordingly.

## For local development on the host:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3333/api/public/otel
## For a Docker container reaching a host-side collector:
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:3333/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic CHANGEME"
OTEL_SERVICE_NAME=strands-base-agent
OTEL_RESOURCE_ATTRIBUTES="service.name=strands-base-agent,service.version=1.0.0,agent.framework=aws-strands"
